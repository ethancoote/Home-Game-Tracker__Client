---
import '../styles/global.css';
import Header from '../components/Header.astro';
import PrimaryBtn from '../components/buttons/PrimaryBtn.astro';
import SecondaryBtn from '../components/buttons/SecondaryBtn.astro';
import NewGame from '../components/NewGame.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import GameCard from '../components/GameCard.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/images/chip.svg" />
		<link rel="icon" href="/images/chip.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Home Game Tracker</title>
	</head>
	<body>
		<Header />
		<div class="wrapper hero gap-64 container tablet-col">
			<div class="container gap-16 m-t-24 tablet-center">
				<h1 class="visitor-only h1-text">Home Game Tracker</h1>
				<p class="visitor-only p-text sub-text">Are you really breaking even in your home games? It's time to find out. Who are the geniuses... Who are the suckers? Track your home game results with your friends.</p>
				<p class="user-only h1-text bold">Let's Play Poker</p>
				<p class="user-only p-text">Create a new game, or browse your existing games.</p>
				<div class="user-only container row gap-12 m-t-16 tablet-center mobile-col">
					<PrimaryBtn text="+ New Game" id="new-game-btn" classes="large"/>
				</div>
				<div class="visitor-only container row gap-12 m-t-16 tablet-center mobile-col">
					<PrimaryBtn text="Login" href="/login" classes="visitor-only large"/>
            		<SecondaryBtn text="Sign Up" href="/signup" classes="visitor-only large"/>
				</div>
			</div>
			<div class="container visitor-only">
				<ResponsiveImage 
					src="cards.webp" 
					alt="Friends playing poker around a small table."
					loading="eager"
					fetchpriority="high"
					folder="/home"
				/>
			</div>
		</div>
		<div class="wrapper">
			<div class="card-section">
				<GameCard game=1 />
				<GameCard />
				<GameCard />
				<GameCard />
			</div>
		</div>
		<NewGame />
	</body>
</html>

<style>
	.card-section {
		width: 100%;
		height: fit-content;
		padding: 16px;
		display: grid;
		background-color: var(--pri-850);
		border-radius: var(--border-radius);
		border: 1px solid var(--pri-700);
		grid-template-columns: repeat(2, auto);
		gap: 16px;
	}
	@media (max-width: 600px) {
		.card-section {
			grid-template-columns: auto;
		}
	}
</style>

<script src="../scripts/logout.js"></script>
<script src="../scripts/manageUI.js"></script>
